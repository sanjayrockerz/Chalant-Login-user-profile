NODE_ENV=development
DATABASE_URL=postgresql://app_user:local_password@127.0.0.1:55436/app_db
DATABASE_URL_AUTH=postgresql://app_user:local_password@127.0.0.1:55436/app_db
REDIS_URL=redis://127.0.0.1:6379
CONTACT_HASH_MODE=sha256-v1
# Required, minimum 32 bytes, only when CONTACT_HASH_MODE=hmac-sha256-v2
CONTACT_HMAC_KEY=

# Email delivery is disabled unless explicitly configured and verified.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.invalid
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TIMEOUT_MS=10000
EMAIL_VERIFY_BASE_URL=
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_BASE_URL=
CANONICAL_RECOVERY_ENABLED=false
RECOVERY_TOKEN_TTL_SECONDS=900
RECOVERY_RATE_LIMIT=3
RECOVERY_RATE_WINDOW_SECONDS=3600
JWT_SECRET=replace-with-a-local-only-secret
COOKIE_SECRET=replace-with-a-local-only-cookie-secret

# Optional Google OIDC server flow. Keep disabled until all values are configured.
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
GOOGLE_OIDC_STATE_TTL_SECONDS=600

# Optional Apple web OIDC. Apple requires a registered HTTPS domain return URL.
APPLE_OIDC_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_FILE=
APPLE_REDIRECT_URI=https://auth.example.test/auth/apple/callback
APPLE_OIDC_STATE_TTL_SECONDS=600
