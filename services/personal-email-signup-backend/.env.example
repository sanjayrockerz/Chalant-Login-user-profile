NODE_ENV=development
DATABASE_URL=postgresql://app_user:local_password@127.0.0.1:55436/app_db
DATABASE_URL_AUTH=postgresql://app_user:local_password@127.0.0.1:55436/app_db
# Local development may use redis://; production startup requires rediss://.
REDIS_URL=redis://127.0.0.1:6379
CONTACT_HASH_MODE=sha256-v1
# Required, minimum 32 bytes, only when CONTACT_HASH_MODE=hmac-sha256-v2
CONTACT_HMAC_KEY=

# Email delivery is disabled unless explicitly configured and verified.
EMAIL_DELIVERY_ENABLED=false
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@example.invalid
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=true
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
EMAIL_SMTP_TIMEOUT_MS=10000
EMAIL_VERIFY_BASE_URL=
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_BASE_URL=
CANONICAL_RECOVERY_ENABLED=false
RECOVERY_TOKEN_TTL_SECONDS=900
RECOVERY_RATE_LIMIT=3
RECOVERY_RATE_WINDOW_SECONDS=3600
JWT_SECRET=replace-with-a-local-only-secret
COOKIE_SECRET=replace-with-a-local-only-cookie-secret

# Internal authentication consumers. An empty allowlist disables introspection.
# Store real per-service HMAC keys in the deployment secret manager.
# Each consumer must explicitly list protocolVersions. Use ["v2"] for new
# Profile/Community consumers; keep ["v1"] only for named legacy consumers.
# Rotate by adding a new key ID, deploying both during overlap, then removing
# the retired key ID to revoke it. Secrets must be at least 32 characters.
# Example production shape (replace the placeholder with a secret-manager value;
# never reuse JWT_SECRET or commit an active HMAC key):
# AUTH_INTROSPECTION_CLIENTS_JSON={"user-profile-service":{"protocolVersions":["v2"],"keys":{"profile-information-v1":"replace-with-at-least-32-random-bytes"},"audiences":["profile-information"],"scopes":["auth:subject:resolve"]}}
AUTH_INTROSPECTION_CLIENTS_JSON={}

# B2-C15 MATCH source-check foundation. Keep disabled until verification and
# originating-session eligibility policy is owner-approved and later batches
# provide Chat commitment integration.
# PROFILE_PAIR_STATE_URL=https://profile.internal.example
# PROFILE_PAIR_STATE_JWT_PRIVATE_KEY=<Auth service RS256 private key trusted by Profile>
# CHAT_MATCH_JOURNAL_URL=https://chat.internal.example
# CHAT_MATCH_JOURNAL_KEY_ID=<Auth service key ID configured in Chat>
# CHAT_MATCH_JOURNAL_HMAC_SECRET=<at least 32 random bytes; separate from other service secrets>
AUTH_MATCH_SOURCE_CHECK_ENABLED=false
AUTH_MATCH_SOURCE_CHECK_TEST_MODE=false
# Pair-safety scope additions for deployments that enable this workflow (merge
# into the service allowlist above; use separate secret-manager values per
# service). MATCH and DISCLOSURE permits remain disabled.
# {"profile-connections-service":{"protocolVersions":["v2"],"keys":{"profile-safety-v1":"replace-with-32-plus-random-bytes"},"audiences":["auth-safety-ordering"],"scopes":["safety:operations:request","safety:operations:inspect","safety:operations:finalize","safety:operations:abort"]},"chat-backend-service":{"protocolVersions":["v2"],"keys":{"chat-safety-v1":"replace-with-32-plus-random-bytes"},"audiences":["auth-safety-ordering"],"scopes":["safety:operations:chat:inspect","safety:receipts:chat"]}}
# Versioned global account/session events are delivered with POST to
# https://<community-host>/api/v1/internal/auth/lifecycle over signed HTTPS.
# Use a dedicated secret; never reuse the Chat provisioning key or JWT_SECRET.
AUTH_LIFECYCLE_URL=
AUTH_LIFECYCLE_HMAC_SECRET=

# Optional Google OIDC server flow. Keep disabled until all values are configured.
GOOGLE_OIDC_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:3000/auth/google/callback
GOOGLE_OIDC_STATE_TTL_SECONDS=600

# Optional Apple web OIDC. Apple requires a registered HTTPS domain return URL.
APPLE_OIDC_ENABLED=false
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_PRIVATE_KEY_FILE=
APPLE_REDIRECT_URI=https://auth.example.test/auth/apple/callback
APPLE_OIDC_STATE_TTL_SECONDS=600
