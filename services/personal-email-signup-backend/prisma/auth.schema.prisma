generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL_AUTH")
}

enum MatchType {
  mutual
  one_sided
}

enum PushTokenPlatform {
  ios
  android
}

enum PushTokenType {
  fcm
  apns
}

enum UserAccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETE
}

enum IdentityProvider {
  PASSWORD
  GOOGLE
  APPLE
}

enum LegacyIdentitySource {
  R1
  R2
  R3
}

enum SafetyOperationType {
  ACCOUNT_MUTATION
  BLOCK
  UNBLOCK
  MATCH
  DISCLOSURE
}

enum SafetyOperationState {
  REQUESTED
  HELD
  CHECKED
  DENIED
  CHAT_COMMITTED
  CHAT_ABORTED
  SOURCE_COMMITTED
  CHAT_PAIR_TERMINATED
  RECOVERY_REQUIRED
  FINALIZED
}

model User {
  id                  String                @id @default(uuid()) @db.Uuid
  username            String                @unique
  normalizedUsername  String?               @unique
  displayUsername     String?
  email               String                @unique
  /// Nullable for provider-only accounts; password accounts use PasswordCredential.
  password            String?
  accountStatus       UserAccountStatus     @default(ACTIVE)
  accountStatusVersion Int                  @default(0) @map("account_status_version")
  isVerified          Boolean               @default(false)
  onboardingStatus    OnboardingStatus     @default(NOT_STARTED) @map("onboarding_status")
  onboardingCompletedAt DateTime?          @map("onboarding_completed_at")
  // Policy acceptance fields
  termsVersion        String?               @db.VarChar(64)
  termsAcceptedAt     DateTime?
  // Optional identity fields (store minimal PII; profile_image_url is a pointer)
  displayName         String?               @db.VarChar(255)
  declaredAge         Int?
  profileImageUrl     String?
  pronouns            String?               @db.VarChar(64)
  usernameUpdatedAt   DateTime?
  phone               String?               @db.VarChar(20)
  phoneVerifiedAt     DateTime?             @map("phone_verified_at")
  hashedPhone         String?               @map("hashed_phone") @db.VarChar(64)
  allowContactDiscovery Boolean                 @default(false) @map("allow_contact_discovery")
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  // verificationToken removed: migrated to Redis-backed OTP flow
  // emailVerification relation removed
  refreshTokens       RefreshToken[]
  hashedContacts      HashedContact[]
  suggestionsAuthored ContactSuggestion[]   @relation("SuggestionOwner")
  suggestionsTargeted ContactSuggestion[]   @relation("SuggestionTarget")
  blocksInitiated     Block[]               @relation("Blocker")
  blocksReceived      Block[]               @relation("Blocked")
  pushTokens          PushToken[]
  identityLinks       UserIdentity[]
  passwordCredential  PasswordCredential?
  identitySessions    IdentitySession[]
  legacyMappings      LegacyIdentityMapping[]
  policyAcceptances   PolicyAcceptance[]

  @@unique([phone], map: "users_phone_key")
  @@index([hashedPhone], map: "idx_users_hashed_phone")
}

/// Minimal permanent marker that prevents an accepted Auth subject from being
/// recreated by stale credentials, lifecycle events, recovery or registration.
/// No direct user relation is intentional so deleting the User row cannot erase it.
model AccountDeletionTombstone {
  authSubject       String   @id @map("auth_subject") @db.Uuid
  lifecycleRevision BigInt   @map("lifecycle_revision")
  deletedAt         DateTime @default(now()) @map("deleted_at") @db.Timestamptz(6)

  @@map("account_deletion_tombstones")
}

/// Durable ordering ledger for source-owner coordination. It contains operation
/// metadata and receipts only; account and Profile/Connections facts remain in
/// their owning repositories.
model SafetyOperation {
  id               String                  @id @db.Uuid
  requestHash      String                  @map("request_hash") @db.Char(64)
  operationType    SafetyOperationType     @map("operation_type")
  callerServiceId  String                  @map("caller_service_id") @db.VarChar(128)
  subjects         String[]                @default([]) @db.Uuid
  resourceKeys     String[]                @default([]) @map("resource_keys")
  waiterTickets    Json?                   @map("waiter_tickets")
  requestMetadata  Json?                   @map("request_metadata")
  state            SafetyOperationState    @default(REQUESTED)
  sourceRevisions  Json?                   @map("source_revisions")
  fenceEpochs      Json?                   @map("fence_epochs")
  sourceReceipt    Json?                   @map("source_receipt")
  chatReceipt      Json?                   @map("chat_receipt")
  failureCode      String?                 @map("failure_code") @db.VarChar(96)
  recoveryMetadata Json?                   @map("recovery_metadata")
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  waiters          SafetyOperationWaiter[]
  ownedResources   SafetyResource[]        @relation("SafetyResourceOwner")

  @@index([state, updatedAt], map: "idx_safety_operations_recovery")
  @@map("safety_operations")
}

/// One row per canonical resource. Row locks serialize ticket allocation and
/// all-or-none grant decisions across independent Auth instances.
model SafetyResource {
  resourceKey      String                  @id @map("resource_key") @db.VarChar(512)
  nextTicket       BigInt                  @default(0) @map("next_ticket")
  fenceEpoch       BigInt                  @default(0) @map("fence_epoch")
  ownerOperationId String?                 @map("owner_operation_id") @db.Uuid
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  owner            SafetyOperation?        @relation("SafetyResourceOwner", fields: [ownerOperationId], references: [id], onDelete: Restrict)
  waiters          SafetyOperationWaiter[]

  @@index([ownerOperationId], map: "idx_safety_resource_owner")
  @@map("safety_resources")
}

/// Durable FIFO queue entry. A waiter's ticket is allocated while holding the
/// same resource row lock used by grant, so enqueue cannot race past a grant.
model SafetyOperationWaiter {
  operationId String          @map("operation_id") @db.Uuid
  resourceKey String          @map("resource_key") @db.VarChar(512)
  ticket      BigInt
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  operation   SafetyOperation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  resource    SafetyResource  @relation(fields: [resourceKey], references: [resourceKey], onDelete: Restrict)

  @@id([operationId, resourceKey])
  @@unique([resourceKey, ticket], map: "uq_safety_waiter_resource_ticket")
  @@index([resourceKey, ticket], map: "idx_safety_waiter_fifo")
  @@map("safety_operation_waiters")
}

/// Replay-protection nonce store for signed SOC requests. Nonces are durable
/// so Redis availability or process restarts cannot reopen the replay window.
model SafetyServiceNonce {
  serviceId String   @map("service_id") @db.VarChar(128)
  keyId     String   @map("key_id") @db.VarChar(128)
  nonceHash String   @map("nonce_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([serviceId, keyId, nonceHash])
  @@index([expiresAt], map: "idx_safety_service_nonces_expiry")
  @@map("safety_service_nonces")
}

/// Durable cross-service intent to provision a Chat-owned profile after signup.
model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(128)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  payload       Json
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now()) @map("next_attempt_at")
  claimedAt     DateTime? @map("claimed_at")
  claimToken    String?   @map("claim_token") @db.Uuid
  deliveredAt   DateTime? @map("delivered_at")
  lastError     String?   @map("last_error")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([eventType, aggregateId], map: "idx_outbox_event_type_aggregate")
  @@index([deliveredAt, nextAttemptAt, claimedAt], map: "idx_outbox_event_pending")
  @@map("chat_profile_provisioning_outbox")
}

/// Append-only audit of administrator-driven account lock/reactivation changes.
/// UUIDs are retained without cascading foreign keys so account removal cannot
/// erase who performed a status change or which subject it affected.
model AccountStatusAudit {
  id           String            @id @default(uuid()) @db.Uuid
  targetUserId String            @map("target_user_id") @db.Uuid
  actorUserId  String            @map("actor_user_id") @db.Uuid
  fromStatus   UserAccountStatus @map("from_status")
  toStatus     UserAccountStatus @map("to_status")
  version      Int
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@unique([targetUserId, version], map: "uniq_account_status_audit_target_version")
  @@index([actorUserId, createdAt], map: "idx_account_status_audit_actor_created")
  @@map("account_status_audit")
}

/// Provider identities are keyed by issuer and stable provider subject, never email.
model UserIdentity {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  provider  IdentityProvider
  issuer    String           @db.VarChar(255)
  subject   String           @db.VarChar(255)
  createdAt  DateTime         @default(now()) @map("created_at")
  updatedAt  DateTime         @updatedAt @map("updated_at")
  lastUsedAt DateTime?       @map("last_used_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, subject], map: "uniq_user_identities_issuer_subject")
  @@index([userId], map: "idx_user_identities_user")
  @@map("user_identities")
}

/// Separate future credential storage. Existing User.password remains for legacy compatibility.
model PasswordCredential {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_credentials")
}

/// Durable replay fence for password recovery. The raw token is never stored;
/// successful reset records its SHA-256 digest in the same transaction as the
/// password update and session revocation.
model PasswordRecoveryConsumption {
  tokenHash  String   @id @map("token_hash") @db.Char(64)
  consumedAt DateTime @default(now()) @map("consumed_at") @db.Timestamptz

  @@map("password_recovery_consumptions")
}

/// Future session ownership boundary. No issuer or session activation is added in Phase 1.
model IdentitySession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  sessionHash String   @unique @map("session_hash") @db.VarChar(128)
  createdAt         DateTime  @default(now()) @map("created_at")
  /// Set only when primary credentials or an external identity provider are verified. Refresh rotation never changes it.
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(6)
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_identity_sessions_user")
  @@index([expiresAt], map: "idx_identity_sessions_expires")
  @@map("identity_sessions")
}

/// Auditable source-qualified mapping for later R1/R2 migration.
model LegacyIdentityMapping {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @map("user_id") @db.Uuid
  source     LegacyIdentitySource
  originalId String               @map("original_id") @db.VarChar(255)
  createdAt  DateTime             @default(now()) @map("created_at")
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([source, originalId], map: "uniq_legacy_identity_source_original")
  @@index([userId], map: "idx_legacy_identity_user")
  @@map("legacy_identity_mappings")
}

model PolicyAcceptance {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  policyVersion String   @map("policy_version") @db.VarChar(64)
  acceptedAt    DateTime @default(now()) @map("accepted_at")
  source        String   @default("api") @db.VarChar(32)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, policyVersion], map: "uniq_policy_acceptance_user_version")
  @@index([userId], map: "idx_policy_acceptance_user")
  @@map("policy_acceptance_history")
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    String   @db.Uuid
  token     String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model HashedContact {
  id          Int       @id @default(autoincrement())
  userId      String    @map("user_id") @db.Uuid
  hashedPhone String    @map("hashed_phone") @db.VarChar(64)
  uploadedAt  DateTime @default(now()) @map("uploaded_at")
  expiresAt   DateTime  @map("expires_at")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, hashedPhone], map: "uniq_hashed_contacts_user_phone")
  @@index([hashedPhone], map: "idx_hashed_contacts_hashed_phone")
  @@index([userId], map: "idx_hashed_contacts_user_id")
  @@index([expiresAt], map: "idx_hashed_contacts_expires_at")
  @@map("hashed_contacts")
}

model ContactSuggestion {
  id              Int        @id @default(autoincrement())
  userId          String     @map("user_id") @db.Uuid
  suggestedUserId String     @map("suggested_user_id") @db.Uuid
  matchType       MatchType  @map("match_type")
  matchStrength   Decimal    @map("match_strength") @db.Decimal(4, 3)
  createdAt       DateTime  @default(now()) @map("created_at")
  viewedAt        DateTime?  @map("viewed_at")
  acceptedAt      DateTime?  @map("accepted_at")
  stale           Boolean    @default(false)
  user            User       @relation("SuggestionOwner", fields: [userId], references: [id], onDelete: Cascade)
  suggestedUser   User       @relation("SuggestionTarget", fields: [suggestedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, suggestedUserId], map: "uniq_contact_suggestions_pair")
  @@index([userId], map: "idx_contact_suggestions_user")
  @@index([userId, matchType], map: "idx_contact_suggestions_user_match_type")
  @@index([suggestedUserId], map: "idx_contact_suggestions_suggested_user")
  @@map("contact_suggestions")
}

model Block {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockerId], map: "idx_blocks_blocker")
  @@index([blockedId], map: "idx_blocks_blocked")
  @@map("blocks")
}

model PushToken {
  id              String             @id @default(uuid()) @db.Uuid
  userId          String             @map("user_id") @db.Uuid
  token           String             @db.VarChar(512)
  platform        PushTokenPlatform
  tokenType       PushTokenType      @map("token_type")
  deviceMetadata  Json?              @map("device_metadata")
  active          Boolean            @default(true)
  lastValidatedAt DateTime?          @map("last_validated_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token, platform], map: "uniq_push_token_user_token_platform")
  @@index([userId], map: "idx_push_tokens_user")
  @@index([active, platform], map: "idx_push_tokens_active_platform")
  @@index([lastValidatedAt], map: "idx_push_tokens_last_validated")
  @@map("push_tokens")
}

// EmailVerificationToken model removed. Tokens are now stored in Redis and
// verified via the OTP flow. The SQL migration in prisma/migrations/
// 20251003_remove_email_verification_token/ contains reversible SQL to
// recreate the table and column if rollback is necessary.
