{
  "name": "personal-email-signup-backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "husky install",
    "secrets:scan": "gitleaks detect --report-format sarif --report-path gitleaks.sarif",
    "prebuild": "npm run prisma:generate:runtime",
    "prisma:generate:runtime": "prisma generate --schema=prisma/auth.schema.prisma",
    "migration:governance:check": "node ../../scripts/phase1-governance-check.js",
    "build": "nest build",
    "typecheck": "npm run prisma:generate:runtime && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/app.module.ts\" \"src/canonical-auth/**/*.ts\" \"src/config/config.schema.ts\" \"src/config/config.service.ts\" \"src/contacts/canonical-*.ts\" \"src/contacts/contact-hash-migration.ts\" \"src/email/**/*.ts\" \"src/identity/**/*.ts\" \"src/policies/canonical-*.ts\" \"src/redis/redis.service.ts\" \"src/security/phone-hash/**/*.ts\" \"src/security/redis-throttler.storage.ts\" \"src/types/**/*.ts\" \"src/user/canonical-*.ts\" \"src/user/profile.controller.ts\" \"test/setup.ts\"",
    "lint:all": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "test:prepare": "npm run prisma:generate:runtime",
    "test": "npm run test:prepare && node ./node_modules/jest/bin/jest.js",
    "test:watch": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --watch",
    "test:cov": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register ./node_modules/jest/bin/jest.js --runInBand",
    "test:e2e": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
    "test:unit": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --testPathPattern=src/.*\\.spec\\.ts$",
    "test:identity:persistence": "npm run test:prepare && node ./node_modules/jest/bin/jest.js src/identity/identity.persistence.integration.spec.ts src/identity/identity.module.integration.spec.ts --runInBand",
    "test:canonical-auth": "npm run test:prepare && node ./node_modules/jest/bin/jest.js src/canonical-auth/canonical-auth.integration.spec.ts --runInBand",
    "test:integration": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --testPathPattern=test/integration/.*\\.spec\\.ts$",
    "test:contract": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --testPathPattern=test/contract/.*\\.spec\\.ts$",
    "test:load": "npm run test:e2e -- --testNamePattern='load'",
    "test:ci": "npm run test:prepare && node ./node_modules/jest/bin/jest.js --coverage --coverageReporters=text-lcov | coveralls",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:e2e",
    "smoke:run": "node ./scripts/run_smoke_checks.js",
    "generate:swagger": "ts-node scripts/generate-swagger.ts",
    "migration:generate": "prisma migrate dev",
    "migration:deploy": "prisma migrate deploy",
    "migration:fresh:init": "node ../../scripts/phase1-fresh-init.js",
    "migration:upgrade:verify": "node ../../scripts/phase1-upgrade-verify.js",
    "migration:reset": "prisma migrate reset",
    "migration:status": "prisma migrate status",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@auth/phone-normalization": "file:../../packages/phone-normalization",
    "@nestjs-modules/ioredis": "^2.0.2",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/microservices": "^11.1.0",
    "@nestjs/mongoose": "^11.0.3",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/typeorm": "^11.0.0",
    "@node-rs/argon2": "^2.0.2",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.64.6",
    "@opentelemetry/sdk-node": "^0.205.0",
    "@prisma/client": "^6.7.0",
    "@types/uuid": "^10.0.0",
    "amqp-connection-manager": "^4.0.0",
    "amqplib": "^0.10.8",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dompurify": "^3.3.0",
    "express": "^5.1.0",
    "express-winston": "^4.2.0",
    "google-auth-library": "10.9.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.6.1",
    "jose": "6.2.12",
    "jsdom": "^21.1.2",
    "jsonwebtoken": "9.0.2",
    "libphonenumber-js": "^1.12.24",
    "mongoose": "^8.14.1",
    "nodemailer": "^7.0.3",
    "p-retry": "^4.6.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.15.6",
    "prom-client": "^15.1.3",
    "redis": "^4.7.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.22",
    "uuid": "^13.0.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.25.76",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@faker-js/faker": "^10.0.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.10.7",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "9.0.10",
    "@types/node": "^22.10.7",
    "@types/supertest": "^6.0.3",
    "@types/winston": "^2.4.4",
    "@types/zxcvbn": "^4.4.3",
    "dotenv": "^16.5.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "husky": "^8.0.0",
    "install": "^0.13.0",
    "jest": "^29.7.0",
    "license-checker": "^25.0.1",
    "openapi-types": "^12.1.3",
    "prettier": "^3.4.2",
    "prisma": "^6.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.1.1",
    "ts-jest": "^29.4.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "prisma": {
    "schema": "prisma/auth.schema.prisma",
    "seed": "ts-node prisma/seed.ts"
  }
}
