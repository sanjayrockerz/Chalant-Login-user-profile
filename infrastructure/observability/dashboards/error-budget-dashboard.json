{
  "dashboard": {
    "id": null,
    "title": "Error Budget Dashboard",
    "tags": ["slo", "error-budget", "reliability"],
    "style": "dark",
    "timezone": "browser",
    "editable": true,
    "graphTooltip": 1,
    "time": {
      "from": "now-30d",
      "to": "now"
    },
    "timepicker": {
      "refresh_intervals": [
        "5m",
        "15m",
        "30m",
        "1h",
        "2h",
        "1d"
      ]
    },
    "refresh": "5m",
    "templating": {
      "list": [
        {
          "name": "service",
          "type": "query",
          "query": "label_values(slo:error_budget_consumed, service)",
          "refresh": 1,
          "includeAll": true,
          "allValue": null,
          "multi": true,
          "options": [],
          "current": {
            "selected": true,
            "text": ["All"],
            "value": ["$__all"]
          }
        },
        {
          "name": "environment",
          "type": "query", 
          "query": "label_values(slo:error_budget_consumed{service=~\"$service\"}, environment)",
          "refresh": 1,
          "includeAll": true,
          "allValue": null,
          "multi": true,
          "options": [],
          "current": {
            "selected": true,
            "text": ["production"],
            "value": ["production"]
          }
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "Error Budget Summary",
        "type": "stat",
        "gridPos": {
          "h": 4,
          "w": 24,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "100 * (1 - (1 - sli:availability_30d{service=~\"$service\", environment=~\"$environment\"}) / (1 - slo:target{service=~\"$service\", environment=~\"$environment\"}))",
            "legendFormat": "{{service}} - {{environment}}",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 25
                },
                {
                  "color": "green",
                  "value": 50
                }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100,
            "decimals": 1
          }
        },
        "options": {
          "reduceOptions": {
            "values": false,
            "calcs": [
              "lastNotNull"
            ],
            "fields": ""
          },
          "orientation": "auto",
          "textMode": "auto",
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto"
        }
      },
      {
        "id": 2,
        "title": "30-Day Error Budget Consumption",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "expr": "100 * slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}",
            "legendFormat": "{{service}} Error Budget Consumed (%)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 15,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 75
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "unit": "percent",
            "max": 100,
            "min": 0
          }
        },
        "options": {
          "legend": {
            "calcs": ["last", "max"],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        }
      },
      {
        "id": 3,
        "title": "Daily Error Budget Burn Rate",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 12
        },
        "targets": [
          {
            "expr": "increase(slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}[1d]) * 100",
            "legendFormat": "{{service}} Daily Burn (%)",
            "refId": "A"
          },
          {
            "expr": "vector(3.33)",
            "legendFormat": "Sustainable Daily Burn Rate",
            "refId": "B"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "bars",
              "fillOpacity": 80,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 1,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "off"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            },
            "unit": "percent"
          }
        },
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Sustainable Daily Burn Rate"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "line"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [10, 10],
                  "fill": "dash"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      {
        "id": 4,
        "title": "Error Budget Velocity",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 12
        },
        "targets": [
          {
            "expr": "deriv(slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}[1h]) * 3600 * 24 * 100",
            "legendFormat": "{{service}} Burn Velocity (%/day)",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 20,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 5
                },
                {
                  "color": "red",
                  "value": 10
                }
              ]
            },
            "unit": "percent"
          }
        },
        "options": {
          "legend": {
            "calcs": [],
            "displayMode": "list",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        }
      },
      {
        "id": 5,
        "title": "Error Budget Forecast",
        "type": "timeseries",
        "gridPos": {
          "h": 8,
          "w": 24,
          "x": 0,
          "y": 20
        },
        "targets": [
          {
            "expr": "100 * slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}",
            "legendFormat": "{{service}} Current Consumption (%)",
            "refId": "A"
          },
          {
            "expr": "100 * predict_linear(slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}[7d], 86400 * 7)",
            "legendFormat": "{{service}} 7-day Forecast (%)",
            "refId": "B"
          },
          {
            "expr": "100 * predict_linear(slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}[7d], 86400 * (30 - day(time())))",
            "legendFormat": "{{service}} End-of-Month Forecast (%)",
            "refId": "C"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "palette-classic"
            },
            "custom": {
              "axisLabel": "",
              "axisPlacement": "auto",
              "barAlignment": 0,
              "drawStyle": "line",
              "fillOpacity": 10,
              "gradientMode": "none",
              "hideFrom": {
                "legend": false,
                "tooltip": false,
                "vis": false
              },
              "lineInterpolation": "linear",
              "lineWidth": 2,
              "pointSize": 5,
              "scaleDistribution": {
                "type": "linear"
              },
              "showPoints": "never",
              "spanNulls": false,
              "stacking": {
                "group": "A",
                "mode": "none"
              },
              "thresholdsStyle": {
                "mode": "line"
              }
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 75
                },
                {
                  "color": "red",
                  "value": 100
                }
              ]
            },
            "unit": "percent",
            "max": 120,
            "min": 0
          }
        },
        "options": {
          "legend": {
            "calcs": ["last"],
            "displayMode": "table",
            "placement": "bottom"
          },
          "tooltip": {
            "mode": "single",
            "sort": "none"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*Forecast.*"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "dash": [5, 10],
                  "fill": "dash"
                }
              }
            ]
          }
        ]
      },
      {
        "id": 6,
        "title": "Current Month Error Budget Status",
        "type": "table",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 28
        },
        "targets": [
          {
            "expr": "100 * (1 - (1 - sli:availability_30d{service=~\"$service\", environment=~\"$environment\"}) / (1 - slo:target{service=~\"$service\", environment=~\"$environment\"}))",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "A"
          },
          {
            "expr": "slo:target{service=~\"$service\", environment=~\"$environment\"} * 100",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "B"
          },
          {
            "expr": "sli:availability_30d{service=~\"$service\", environment=~\"$environment\"} * 100",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "C"
          },
          {
            "expr": "100 * predict_linear(slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}[7d], 86400 * (30 - day(time())))",
            "format": "table",
            "instant": true,
            "legendFormat": "",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "custom": {
              "align": "auto",
              "displayMode": "auto"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            },
            "unit": "percent",
            "decimals": 2
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "service"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Service"
                },
                {
                  "id": "unit",
                  "value": "string"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Value #A"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Error Budget Remaining"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 25
                      },
                      {
                        "color": "green",
                        "value": 50
                      }
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Value #B"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "SLO Target"
                },
                {
                  "id": "unit",
                  "value": "percent"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Value #C"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Current Availability"
                },
                {
                  "id": "unit",
                  "value": "percent"
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Value #D"
              },
              "properties": [
                {
                  "id": "displayName",
                  "value": "Month-End Forecast"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 75
                      },
                      {
                        "color": "red",
                        "value": 100
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "showHeader": true
        },
        "transformations": [
          {
            "id": "merge",
            "options": {}
          },
          {
            "id": "organize",
            "options": {
              "excludeByName": {
                "Time": true,
                "environment": true
              },
              "indexByName": {},
              "renameByName": {}
            }
          }
        ]
      },
      {
        "id": 7,
        "title": "Risk Assessment",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 28
        },
        "targets": [
          {
            "expr": "round((100 * slo:error_budget_consumed{service=~\"$service\", environment=~\"$environment\"}) / (day(time()) / 30), 0.1)",
            "legendFormat": "{{service}} - Burn Rate vs Expected",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [
              {
                "options": {
                  "from": 0,
                  "result": {
                    "color": "green",
                    "index": 0,
                    "text": "LOW RISK"
                  },
                  "to": 1.5
                },
                "type": "range"
              },
              {
                "options": {
                  "from": 1.5,
                  "result": {
                    "color": "yellow",
                    "index": 1,
                    "text": "MEDIUM RISK"
                  },
                  "to": 3
                },
                "type": "range"
              },
              {
                "options": {
                  "from": 3,
                  "result": {
                    "color": "red",
                    "index": 2,
                    "text": "HIGH RISK"
                  },
                  "to": 100
                },
                "type": "range"
              }
            ],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 1.5
                },
                {
                  "color": "red",
                  "value": 3
                }
              ]
            },
            "unit": "none"
          }
        },
        "options": {
          "colorMode": "background",
          "graphMode": "none",
          "justifyMode": "center",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "value_and_name"
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        }
      ]
    },
    "links": [
      {
        "asDropdown": false,
        "icon": "external link",
        "includeVars": true,
        "keepTime": true,
        "tags": [],
        "targetBlank": true,
        "title": "SLO Overview",
        "tooltip": "",
        "type": "link",
        "url": "/d/slo-overview/slo-overview"
      },
      {
        "asDropdown": false,
        "icon": "external link",
        "includeVars": true,
        "keepTime": false,
        "tags": [],
        "targetBlank": true,
        "title": "Monthly SLO Report",
        "tooltip": "",
        "type": "link",
        "url": "/d/monthly-slo/monthly-slo-report"
      }
    ]
  },
  "overwrite": true
}