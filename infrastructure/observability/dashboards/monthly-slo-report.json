      {
        "id": 7,
        "title": "SLO Compliance Score",
        "type": "gauge",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 32
        },
        "targets": [
          {
            "expr": "100 * avg(sli:availability_30d{service=~\"$service\"} >= slo:target{service=~\"$service\"}) by (service)",
            "legendFormat": "{{service}} Compliance %",
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "red",
                  "value": null
                },
                {
                  "color": "yellow",
                  "value": 90
                },
                {
                  "color": "green",
                  "value": 95
                }
              ]
            },
            "unit": "percent",
            "min": 0,
            "max": 100
          }
        },
        "options": {
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "showThresholdLabels": false,
          "showThresholdMarkers": true,
          "text": {}
        }
      },
      {
        "id": 8,
        "title": "Key Performance Indicators",
        "type": "stat",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 32
        },
        "targets": [
          {
            "expr": "count(sli:availability_30d{service=~\"$service\"} >= slo:target{service=~\"$service\"})",
            "legendFormat": "Services Meeting SLO",
            "refId": "A"
          },
          {
            "expr": "count(sli:availability_30d{service=~\"$service\"})",
            "legendFormat": "Total Services",
            "refId": "B"
          },
          {
            "expr": "count(ALERTS{alertname=~\"SLO.*\", alertstate=\"firing\", service=~\"$service\"})",
            "legendFormat": "Active SLO Alerts",
            "refId": "C"
          },
          {
            "expr": "avg(100 * (1 - (1 - sli:availability_30d{service=~\"$service\"}) / (1 - slo:target{service=~\"$service\"})))",
            "legendFormat": "Avg Error Budget Remaining",
            "refId": "D"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "thresholds"
            },
            "mappings": [],
            "thresholds": {
              "mode": "absolute",
              "steps": [
                {
                  "color": "green",
                  "value": null
                },
                {
                  "color": "red",
                  "value": 80
                }
              ]
            },
            "unit": "short"
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "Active SLO Alerts"
              },
              "properties": [
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 1
                      },
                      {
                        "color": "red",
                        "value": 3
                      }
                    ]
                  }
                }
              ]
            },
            {
              "matcher": {
                "id": "byName",
                "options": "Avg Error Budget Remaining"
              },
              "properties": [
                {
                  "id": "unit",
                  "value": "percent"
                },
                {
                  "id": "color",
                  "value": {
                    "mode": "thresholds"
                  }
                },
                {
                  "id": "thresholds",
                  "value": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": null
                      },
                      {
                        "color": "yellow",
                        "value": 25
                      },
                      {
                        "color": "green",
                        "value": 50
                      }
                    ]
                  }
                }
              ]
            }
          ]
        },
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "auto",
          "orientation": "auto",
          "reduceOptions": {
            "calcs": [
              "lastNotNull"
            ],
            "fields": "",
            "values": false
          },
          "textMode": "auto"
        }
      }
    ],
    "annotations": {
      "list": [
        {
          "builtIn": 1,
          "datasource": "-- Grafana --",
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations & Alerts",
          "type": "dashboard"
        },
        {
          "datasource": "prometheus",
          "enable": true,
          "expr": "ALERTS{alertname=~\"SLO.*\", alertstate=\"firing\", service=~\"$service\"}",
          "iconColor": "red",
          "name": "SLO Violations",
          "tagKeys": "service,severity",
          "textFormat": "{{alertname}} - {{service}}",
          "titleFormat": "SLO Violation"
        }
      ]
    },
