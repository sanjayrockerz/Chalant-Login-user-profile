<!DOCTYPE html>
<html>
<head>
    <style>
        body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }
        .alert-header { background-color: #f8f9fa; padding: 20px; border-left: 5px solid #dc3545; margin-bottom: 20px; }
        .alert-critical { border-left-color: #dc3545; }
        .alert-warning { border-left-color: #ffc107; }
        .alert-resolved { border-left-color: #28a745; }
        .service-name { font-size: 24px; font-weight: bold; margin-bottom: 10px; }
        .alert-details { background-color: #f8f9fa; padding: 15px; margin: 15px 0; border-radius: 5px; }
        .action-links { margin-top: 20px; }
        .action-links a { display: inline-block; padding: 10px 15px; background-color: #007bff; color: white; text-decoration: none; border-radius: 5px; margin-right: 10px; }
        .correlation-id { font-family: monospace; background-color: #e9ecef; padding: 2px 5px; border-radius: 3px; }
    </style>
</head>
<body>
    <div class="alert-header alert-{{ if eq .Status "firing" }}{{ (index .Alerts 0).Labels.severity }}{{ else }}resolved{{ end }}">
        <div class="service-name">
            {{ if eq .Status "firing" }}🚨 SLO VIOLATION{{ else }}✅ SLO RESOLVED{{ end }} - {{ .GroupLabels.service | upper }}
        </div>
        <p><strong>Status:</strong> {{ .Status | title }}</p>
        <p><strong>Time:</strong> {{ .CommonAnnotations.timestamp | date "2006-01-02 15:04:05 MST" }}</p>
    </div>

    {{ range .Alerts }}
    <div class="alert-details">
        <h3>{{ .Labels.service }} - {{ .Labels.slo_type | title }} SLO</h3>
        <p><strong>Environment:</strong> {{ .Labels.environment }}</p>
        <p><strong>Severity:</strong> {{ .Labels.severity | upper }}</p>
        
        <h4>Description:</h4>
        <p>{{ .Annotations.description }}</p>
        
        {{ if .Annotations.correlation_id }}
        <p><strong>Correlation ID:</strong> <span class="correlation-id">{{ .Annotations.correlation_id }}</span></p>
        {{ end }}
        
        {{ if .Annotations.trace_id }}
        <p><strong>Trace ID:</strong> <span class="correlation-id">{{ .Annotations.trace_id }}</span></p>
        {{ end }}
        
        <div class="action-links">
            <a href="{{ .Annotations.grafana_url }}">📊 View Dashboard</a>
            <a href="{{ .Annotations.runbook_url }}">📖 View Runbook</a>
            {{ if .Annotations.logs_url }}
            <a href="{{ .Annotations.logs_url }}">📝 View Logs</a>
            {{ end }}
        </div>
    </div>
    {{ end }}

    <hr>
    <p><small>This alert was generated by Prometheus Alertmanager. For questions, contact the Platform Engineering team.</small></p>
</body>
</html>
{{ end }}